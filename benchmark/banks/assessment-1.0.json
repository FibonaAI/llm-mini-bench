  "selection": {
    "K23_HTTP_Conditional_Cache_Precedence": {
      "role": "knowledge_text",
      "reason": "Tests RFC 9110 §13.1.2 weak comparison on If-None-Match: \"rev-7\" against W/\"rev-7\" (304), §13.1.5 strong comparison failure on If-Range: \"rev-7\" against W/\"rev-7\" ignoring unsatisfiable Range (200), §13.2.2 If-Match: * suppressing If-Unmodified-Since (204), 304 header retention of s-maxage=40 over new Expires=300s, min-fresh=20 with initial Age=15 at t=10, Pragma: no-cache ignored when Cache-Control is present, and RFC 5861 stale-while-revalidate windowing."
    },
    "K23_IEEE754_ThreeValued_Semantics": {
      "role": "knowledge_text",
      "reason": "Tests IEEE 754-2019 double-rounding at bit -106 (where fl(2^-53 + 2^-106) ties down to 2^-53 giving d1=0, while fl(2^-53 - 2^-107) ties up to 2^-53 and then ties up on (1 + 2^-52) + 2^-53 giving d3=1), and ISO SQL composite UNIQUE(x, y) allowing duplicate partial-NULL (NULL, -5) rows combined with CHECK passing on UNKNOWN for x NOT IN (2, NULL)."
    },
    "R23_InContext_Glyph_Morphism": {
      "role": "reasoning_text",
      "reason": "Tests in-context induction of a Z_5 chiral braid algebraic system (kappa, mu, [alpha,beta,gamma], delta, omega) from 7 traces plus inducing the Back-Reflection Echo law from worked chain traces C1-C4, applied to a 5-cell dynamic chain reduction and 30-state inverse synthesis."
    },
    "R23_InContext_Conservation_Frames": {
      "role": "reasoning_text",
      "reason": "Tests in-context scientific law discovery in a 6-state chiral flux lattice (inducing shear lambda, overlap_precedence, ratchet_rule, and discharge_multiplier from calibration expectations) and 3-step sequential state/frustration tracking across Resonant Pinning, Null-Impulse carry, and Free Recoil discharge."
    },
    "C23_Async_Generator_Finally_Override": {
      "role": "code_text",
      "reason": "Tests ECMAScript AsyncGenerator yield* delegation where gen.throw(\"boom\") suspends at a yield inside inner() finally block; gen.next(7) resumes inner() finally block and re-throws \"boom\" into worker() catch block, which rebinds alias and pauses at await Promise.resolve() while queued gen.return(\"abort\") waits behind the in-flight next(7) microtask."
    },
    "C23_MVCC_Savepoint_SSI": {
      "role": "code_text",
      "reason": "Tests PostgreSQL MVCC savepoint rollback visibility, SIREAD predicate-lock retention across ROLLBACK TO SAVEPOINT (s2), write-lock release vs retained SIREAD when a concurrent transaction rolls back its conflicting write inside a savepoint (s3), and 3-transaction SSI dangerous structure detection with a read-only transaction at snapshot v1 (s4)."
    },
    "X23_Subagent_MultiTrack_Reconciliation": {
      "role": "context_text",
      "reason": "Tests main-subagent multi-track coordination across 2-hop forkId (sub-1 -> sub-3 -> sub-6) pendingInbound read boundaries, rebase_onto_shared configuration sync, waiting_for_children premature reply rejection with Turn-2 followUp watchdog recovery, and sequential worktree merge conflict cascade at t=120s."
    },
    "E23_Tight_Conditional_Audit": {
      "role": "context_tool",
      "reason": "Tests 6-call selective document retrieval, field-level authority isolation on n4, non-commuting transfer guards T1/T2, and role-scoped authority where qa is only authorized to modify latency_max and recovery_min (so conditional build exemption w2 is an unauthorized directive and ignored despite its unrevoked timestamp at 15:00)."
    },
    "I23_MultiAgent_DAG_Orchestration": {
      "role": "instruction_text",
      "reason": "Tests multi-subagent DAG scheduling under worker/verifier slot caps and shared locks, two-stage verifier sign-off handoff (requires_signoff: true retaining locks across V1 queue while freeing W2), split speculative predicates (!= failed vs == clean), and pro-rata mid-flight cancellation."
    },
    "I23_Polysemy_Contextual_Translation": {
      "role": "instruction_text",
      "reason": "Tests zero-glossary cross-context polysemy matching across 20 English legal/historical anchors (present, charge, avoid, determine) and 20 Classical Chinese anchors (坐, 按, 课, 适) plus an 8-item unannotated reverse-decoy bilingual translation audit."
    },
    "T23_Adaptive_Fault_Diagnosis": {
      "role": "tool_blackbox",
      "reason": "Tests in-context sensor transducer calibration (saturation wrap at r=4 and resonant phase-mirror flip j mod 3 == a_i) coupled with 2-probe minimax backward induction (P08 -> P04) to isolate F09."
    },
    "T23_Delegated_Authority_Release": {
      "role": "tool_delegated_release",
      "reason": "Tests 5-layer (R->C->S->W->L) subagent delegation scope intersection and global capacity planning across 8 records A..H with inverted-MRV leaf traps (L01/L02 under C1 and L03/L04 under C2)."
    }
  },
