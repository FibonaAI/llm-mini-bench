  "selection": {
    "K23_HTTP_Conditional_Cache_Precedence": {
      "role": "knowledge_text",
      "reason": "Tests RFC 9110 Section 13.1.3 (If-None-Match present and evaluating to true forces ignoring If-Modified-Since -> 200), Section 13.1.5 (If-Range strong-comparison failure against weak W/\"rev-7\" forces ignoring unsatisfiable Range: bytes=5000-5999 -> 200 instead of 416), Section 13.2.2 Step 1 (If-Match: * suppresses If-Unmodified-Since -> 204), Pragma: no-cache with vs without Cache-Control, and RFC 5861 stale-while-revalidate windowing."
    },
    "K23_IEEE754_ThreeValued_Semantics": {
      "role": "knowledge_text",
      "reason": "Tests IEEE 754-2019 double-rounding at bit -106 (where fl(2^-53 + 2^-106) ties down to 2^-53 giving d1=0, while fl(2^-53 - 2^-107) ties up to 2^-53 and then ties up on (1 + 2^-52) + 2^-53 giving d3=1), and ISO SQL composite UNIQUE(x, y) allowing duplicate partial-NULL (NULL, -5) rows combined with CHECK passing on UNKNOWN for x NOT IN (2, NULL)."
    },
    "R23_InContext_Glyph_Morphism": {
      "role": "reasoning_text",
      "reason": "Tests in-context induction of hidden morphism parameters (kappa, rho, omega) from 3 calibration traces and generalization across non-involutive neutral-spin twists, shielded pre-shifts triggering zero-charge phase mirrors, and vacuum-quench inversion."
    },
    "R23_InContext_Conservation_Frames": {
      "role": "reasoning_text",
      "reason": "Tests in-context learning of non-Pearl flux-conserving clamp dynamics with null-impulse exemption (when k == X_nat(U)), parity shield gates, and over-driven counterfactual hysteresis ratcheting."
    },
    "C23_Async_Generator_Finally_Override": {
      "role": "code_text",
      "reason": "Tests that gen.next(3) synchronously resumes inner()'s finally block (pushing 'IF2:3:7' before the queued microtask 'M:107'), whereas inner.next(3) returns a rejected Promise that worker()'s yield* awaits via Await, allowing 'M:107' to execute strictly between 'IF2:3:7' and worker()'s catch block ('C:boom:107')."
    },
    "C23_MVCC_Savepoint_SSI": {
      "role": "code_text",
      "reason": "Tests AtSubAbort_PredicateLocks retention of SIREAD locks and already-recorded rw-conflicts, and unhinted Cahill/PostgreSQL SSI read-only snapshot timing (where T1 commits when read-only T3 took snapshot v0 before T2 committed, but aborts as a cycle-free false positive when T3 took snapshot v1 after T2 committed)."
    },
    "X23_Subagent_MultiTrack_Reconciliation": {
      "role": "context_text",
      "reason": "Tests main-subagent multi-track coordination across steer (tool-boundary) vs followUp (turn-boundary) delivery, forkId snapshot inheritance before steer read, waiting_for_children premature reply rejection, and worktree rebase vs disjoint-file merge admission."
    },
    "E23_Tight_Conditional_Audit": {
      "role": "context_tool",
      "reason": "Tests 6-call selective document retrieval, field-level authority isolation on n4, non-commuting transfer guards T1 (n1->n2 when c=c1) and T2 (c1->c2 when n=n1) that cannot chain from (c1,n1) to (c2,n2) for Build B, and a double-masked waiver trap where w2 [ops] is revoked at 15:10 (> 15:00 timing decoy) and has satisfied guard 'iff D has valid latency evidence', masking the fact that ops only has authority for latency waivers (not recovery waivers)."
    },
    "I23_MultiAgent_DAG_Orchestration": {
      "role": "instruction_text",
      "reason": "Tests multi-subagent parallel DAG scheduling under shared lock contention ('core' delaying J2 while speculative J3/J5 run), structured-receipt precedence over prompt-injected summaries, mid-flight pro-rata speculative cancellation, and runtimeMode ceilings."
    },
    "I23_Polysemy_Contextual_Translation": {
      "role": "instruction_text",
      "reason": "Tests cross-scenario polysemy and contronym disambiguation (UK vs US parliamentary 'table', legal/audit 'qualified', 3-way Chinese antanaclasis on '假', '坐/坐支', and '适', and unmarked bilingual translation audit on '除', '不刊', and '负担行为')."
    },
    "T23_Adaptive_Fault_Diagnosis": {
      "role": "tool_blackbox",
      "reason": "Tests in-context sensor transducer calibration (saturation wrap at r=4 and resonant phase-mirror flip j mod 3 == a_i) coupled with 2-probe minimax backward induction (P08 -> P04) to isolate F09."
    },
    "T23_Delegated_Authority_Release": {
      "role": "tool_delegated_release",
      "reason": "Tests 5-layer (R->C->S->W->L) subagent delegation scope intersection and global capacity planning across 8 records A..H with inverted-MRV leaf traps (L01/L02 under C1 and L03/L04 under C2)."
    }
  },
