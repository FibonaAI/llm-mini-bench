    "E25_Tight_Budget_Deductive_Audit": {
      "type": "assessment-documents-v2",
      "name": "investigate",
      "config": {
        "entry_document": "INDEX",
        "documents": {
          "INDEX": {
            "content": "Cold-chain freight file 409. Carrier: Northline. Consignment: 18 crates of frozen fillets, 72 kg net per crate (plus 110 kg pallet tare). Dispatched 03 Oct; delivered 05 Oct. Governing tariff rules: RULE. Preliminary desk note: BRIEF. All dates fall in the same year."
          },
          "BRIEF": {
            "content": "Preliminary desk note (unverified): Assumes 1,180 kg net cargo and suggests checking LOG_A and TAR_B. Superseded by file 409 crate count and RULE."
          },
          "RULE": {
            "content": "Cold-chain shipments use TAR_B only if ALL three conditions hold: (1) temperature log LOG_A has no reading above 4 C, (2) total net cargo weight is at most 1,200 kg, and (3) carrier endorsement in CERT was active on the dispatch date. If condition (3) holds for a cold-chain shipment but (1) or (2) fails, use TAR_C. If condition (3) fails, use TAR_A. Pull itemized figures from LEDGER."
          },
          "LOG_A": {
            "content": "Temperature logger 409: continuous readings between 1.8 C and 3.4 C; zero excursions above 4 C."
          },
          "CERT": {
            "content": "Endorsement register (effective inclusive):\nNorthline cold-chain endorsement #88: active 01 Oct through 04 Oct (suspended 05 Oct).\nSouthway cold-chain endorsement #91: active 04 Oct through 31 Oct."
          },
          "LEDGER": {
            "content": "File 409 ledger (USD): Base freight 9,400. Cold-chain handling 1,850. Prepayment received 2,600. Pending unverified damage notice 900 (not settled; excluded from invoice)."
          },
          "TAR_A": {
            "content": "Schedule TAR_A (Code DM-1): Invoice equals base freight minus prepayment received."
          },
          "TAR_B": {
            "content": "Schedule TAR_B (Code CC-3): Invoice equals base freight plus cold-chain handling minus prepayment received."
          },
          "TAR_C": {
            "content": "Schedule TAR_C (Code CC-7): Invoice equals base freight plus cold-chain handling plus a 15% surcharge on base freight only, minus prepayment received."
          }
        },
        "query_limit": 5,
        "required_evidence_documents": [
          "INDEX",
          "RULE",
          "CERT",
          "LEDGER",
          "TAR_C"
        ],
        "evidence_gated_fields": [
          "tariff_code",
          "balance_usd"
        ],
        "expected": {
          "tariff_code": {
            "$aliases": [
              "CC-7",
              "Code CC-7"
            ]
          },
          "balance_usd": 10060
        }
      }
    },
