  "selection": {
    "K25_IPv4_BitReverse_Abduction": {
      "role": "knowledge_text",
      "reason": "Abduct 8-bit serial LSB/MSB bit-reversal of uppercase ASCII country tags disguised as IPv4 dotted quads with no mechanism hint."
    },
    "K25_FIDE_Perft_EdgeCases": {
      "role": "knowledge_text",
      "reason": "Count exact FIDE legal moves and checking moves across two compact FEN positions combining horizontal en passant pin, diagonal pin, promotion checks, and castling legality edge cases."
    },
    "R25_Shifted_Pinyin_Abduction": {
      "role": "reasoning_text",
      "reason": "Recover a short Chinese message across composed physical key displacement and Pinyin syllable segmentation without mechanism hints."
    },
    "R25_Morse_Sentence_Camouflage": {
      "role": "reasoning_text",
      "reason": "Abduct ITU Morse dot/dash polarity inversion across five camouflaged real English words with no radio or encoding hint."
    },
    "C25_FourSlot_Readback": {
      "role": "code_text",
      "reason": "Determine minimal total atomic interleaving steps for ascending (a<b) and descending (a>b) torn readbacks in a 4-slot ring store with checkpoint/rollback recovery and dual head guards."
    },
    "C25_Clock_Belady_Anomaly": {
      "role": "code_text",
      "reason": "Find the shortest lexicographically first request sequence exhibiting a capacity-3 vs capacity-2 Belady anomaly in a second-chance (Clock) cache implementation."
    },
    "X25_Checkout_Credit_Audit": {
      "role": "context_text",
      "reason": "Settle a two-site rider using customer-level failure fractions despite retry traffic and staggered rollback."
    },
    "E25_Tight_Budget_Deductive_Audit": {
      "role": "context_interactive",
      "reason": "Resolve a cold-chain freight tariff and final invoice balance within a strict 5-fetch budget by resisting the unverified BRIEF note and eliminating LOG_A via arithmetic from INDEX before fetching TAR_C."
    },
    "I25_SOP_MinStep_Protocol": {
      "role": "instruction_text",
      "reason": "Compute the minimum-step startup toggle sequence and lexicographically first tie-break across five strictly load-bearing valve interlock and cooldown rules."
    },
    "I25_Bilingual_Custody_Discrepancy": {
      "role": "instruction_text",
      "reason": "Classify independent entailed events, preserving quantifier scope, entity, timing and the difference between permission and action."
    },
    "T25_Deceptive_Relay_Matrix": {
      "role": "tool_use_interactive",
      "reason": "Ten of eleven balanced 8:8 openings strand a branch; isolating any of 16 revisions within 4 probes requires the unique certified opening I and unique feasible second probes."
    },
    "T25_Delegated_Manifest_Dispatch": {
      "role": "tool_use_interactive",
      "reason": "Leaf scopes, signed ancestry and handle membership rule out two consignments. Saturating both an intermediate and a higher allocation requires reserving different chains."
    }
  },
  "scoring_policy": {
    "content": "Equal weight across all 12 tasks and all prespecified rounds; each task grades its exact semantic answer fields or within-budget interactive simulator target.",
    "instruction": "JSON-only, exact top-level fields and tool-use checks remain separate from content scores.",
    "missing": "A missing or ungradable sample leaves the whole-bank total null. Partial observed means are labeled separately; API failures are never imputed zero.",
    "repeats": "Preserve all prespecified rounds and failed attempts. Never select best-of results or substitute screening answers.",
    "identity": "Record exact catalog route claims, requested thinking, source/task hashes and per-sample execution protocol. Route labels do not verify the serving model.",
    "scope": "Official Assessment 2.0 12-task bank, isolated from Assessment 1.0 records, baselines and charts while sharing execution and SQLite infrastructure."
  },
