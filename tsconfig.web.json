  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "useUnknownInCatchVariables": false
  },
  "include": ["benchmark/web/**/*.js", "magpie/page/*.js", "benchmark/types/*.d.ts"]
}
